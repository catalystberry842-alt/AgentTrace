# Optional public RPC. Defaults to https://testnet-rpc.monad.xyz, then the other public testnet
# endpoints. Setting it disables the fallbacks. Server-only.
MONAD_TESTNET_RPC_URL=
# Optional. eth_getLogs block window (public RPCs allow 100) and per-request indexer time budget.
MONAD_LOGS_BLOCK_RANGE=
MONAD_INDEXER_BUDGET_MS=

# Postgres. If unset, the app uses a local PGLite database (in memory on serverless hosts).
# Do not set it together with VITE_AUTH_ENABLED=false; the server refuses that combination.
DATABASE_URL=

# Optional. Private Vercel Blob store token. When set, the indexer caches raw chain logs and the
# last scanned block so new serverless instances do not rescan from the deploy block. Server-only.
BLOB_READ_WRITE_TOKEN=

# Confirmed contract addresses. Leave empty until a deployment exists.
# Either name is accepted. Addresses are not invented.
AGENT_REGISTRY_ADDRESS=
MONAD_TESTNET_AGENT_REGISTRY=
AGENT_REGISTRY_DEPLOY_BLOCK=

AGENT_FIREWALL_ADDRESS=
MONAD_TESTNET_AGENT_FIREWALL=
AGENT_FIREWALL_DEPLOY_BLOCK=

AGENT_PROOF_ADDRESS=
MONAD_TESTNET_AGENT_PROOF=
AGENT_PROOF_DEPLOY_BLOCK=

AGENT_DEMO_PROTOCOL=
MONAD_TESTNET_DEMO_PROTOCOL=

# Server-only. Signs AgentProof.anchorProof. Never expose to the browser.
AGENT_PROOF_VERIFIER_PRIVATE_KEY=

# Deploy script only (npm run deploy:testnet → scripts/deploy-contracts.mjs). Needs testnet MON
# from https://faucet.monad.xyz. Never expose to the browser or commit it.
MONAD_DEPLOYER_PRIVATE_KEY=

# Set to false for wallet-only mode (no application accounts; used on Vercel).
VITE_AUTH_ENABLED=

# Application auth secret read by Better Auth. Never expose to the browser.
AUTH_SECRET=

# --- V3 contracts (scripts/deploy-v3.mjs) -----------------------------------------------------
# Verifier set and threshold for AgentProofQuorum. Comma-separated addresses.
AGENT_PROOF_VERIFIERS=
AGENT_PROOF_THRESHOLD=
# Index more firewall contracts next to the primary one, keeping its history (V1) visible.
# Comma-separated key:address:deployBlock; ids from these show as <key>-<id> (e.g. v3-1).
# Leave empty for current behaviour. Example (mainnet V3, pre-audit build):
#   AGENT_FIREWALL_EXTRA_SOURCES=v3:0x06f7ba5b998e3b33ed8df7a936eac82ea95be50f:<deploy block>
AGENT_FIREWALL_EXTRA_SOURCES=
# 2-of-2 (m-of-n) anchoring: when set, AGENT_PROOF_VERIFIER_PRIVATE_KEY attests to this
# AgentProofQuorum instead of AgentProof. AgentProof stays readable for existing anchors.
AGENT_PROOF_QUORUM_ADDRESS=
AGENT_PROOF_QUORUM_DEPLOY_BLOCK=
# Prefer the two settings above over repointing AGENT_FIREWALL_ADDRESS / AGENT_PROOF_ADDRESS,
# which would stop indexing the old contracts.

# Independent verifier (scripts/second-verifier.mjs). Run it on a separate machine; never put
# it on the same host as AGENT_PROOF_VERIFIER_PRIVATE_KEY.
SECOND_VERIFIER_PRIVATE_KEY=
